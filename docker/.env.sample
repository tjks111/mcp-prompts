# MCP-Prompts Server Environment Variables Sample
# Copy this file to .env and modify as needed

# Core Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage Configuration
STORAGE_TYPE=file
PROMPTS_DIR=/app/data/prompts
BACKUPS_DIR=/app/data/backups

# HTTP Server Configuration
HTTP_SERVER=true

# Server-Sent Events (SSE) Configuration
ENABLE_SSE=true
SSE_PATH=/events # Standardized path
SSE_HEARTBEAT_INTERVAL_MS=30000 # Interval for SSE heartbeats in milliseconds
SSE_CLIENT_TIMEOUT_MS=60000 # Timeout for inactive SSE clients in milliseconds
SSE_MESSAGE_HISTORY=50 # Number of messages to keep in history for SSE clients
CORS_ORIGIN=*

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcp_prompts
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp_pass
POSTGRES_SSL=false
